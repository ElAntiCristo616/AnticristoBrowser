<?xml version="1.0" encoding="utf-8"?>
<!-- Hoja de destino v1.1.0: lista de teles encontradas en el Wi-Fi
     (Roku, Chromecast, DLNA) para elegir a cuál transmitir. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_sheet_top"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingBottom="16dp">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_gradient_button" />

    <TextView
        android:id="@+id/sheetTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="¿A qué tele lo mando?"
        android:textColor="@color/neo_text"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/sheetSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Teles en este Wi-Fi. La tele y el teléfono deben estar en la misma red."
        android:textColor="@color/neo_muted"
        android:textSize="13sp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp">

        <LinearLayout
            android:id="@+id/sheetDeviceList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <Button
        android:id="@+id/btnBuscarTeles"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_gradient_button"
        android:text="Buscar teles"
        android:textColor="@color/neo_text"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btnSheetCerrar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="12dp"
        android:backgroundTint="@color/neo_surface_light"
        android:text="Cerrar"
        android:textColor="@color/neo_text" />
</LinearLayout>
