<?xml version="1.0" encoding="utf-8"?>
<!-- Bottom sheet de videos detectados (v1.1.0): look fijo neón.
     La lista se arma por código, un renglón por video; cada video se
     despliega para ver SUS calidades y transmitir ESE video. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_sheet_top"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingBottom="16dp">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_gradient_button" />

    <TextView
        android:id="@+id/sheetTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Videos en esta página"
        android:textColor="@color/neo_text"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/sheetSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Toca un video para ver sus calidades y transmitirlo a la tele."
        android:textColor="@color/neo_muted"
        android:textSize="13sp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp">

        <LinearLayout
            android:id="@+id/sheetVideoList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <Button
        android:id="@+id/btnSheetCerrar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="12dp"
        android:backgroundTint="@color/neo_surface_light"
        android:text="Cerrar"
        android:textColor="@color/neo_text" />
</LinearLayout>
