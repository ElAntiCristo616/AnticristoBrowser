<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <com.elanticristo616.browser.GarlandView
                android:layout_width="match_parent"
                android:layout_height="56dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Anticristo Browser"
                android:textColor="@color/snow_white"
                android:textSize="28sp"
                android:textStyle="bold"
                android:layout_marginTop="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Busca con DuckDuckGo y manda videos a tu tele"
                android:textColor="@color/sage"
                android:textSize="14sp"
                android:layout_marginBottom="12dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/card_bg"
                android:orientation="horizontal"
                android:padding="6dp">

                <EditText
                    android:id="@+id/etBuscar"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:hint="Busca con DuckDuckGo"
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:textColor="@color/snow_white"
                    android:textColorHint="@color/sage"
                    android:textSize="16sp" />

                <Button
                    android:id="@+id/btnBuscarWeb"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:backgroundTint="@color/red_accent"
                    android:text="Ir"
                    android:textColor="@color/snow_white" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Accesos rápidos"
                android:textColor="@color/sage"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:id="@+id/quickRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="5" />

            <!-- Conectar a la tele -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Conectar a la tele"
                android:textColor="@color/sage"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/card_bg"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:id="@+id/tvStatusTele"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Sin tele conectada."
                    android:textColor="@color/snow_white"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/btnBuscarTeles"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:backgroundTint="@color/red_accent"
                    android:text="Buscar teles en mi Wi-Fi"
                    android:textColor="@color/snow_white" />

                <LinearLayout
                    android:id="@+id/devicesContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="O escribe la IP de la tele a mano:"
                    android:textColor="@color/sage"
                    android:textSize="13sp"
                    android:layout_marginTop="12dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="4dp">

                    <EditText
                        android:id="@+id/etIpManual"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:background="@drawable/card_bg"
                        android:hint="192.168.1.5"
                        android:inputType="numberDecimal"
                        android:textColor="@color/snow_white"
                        android:textColorHint="@color/sage" />

                    <Button
                        android:id="@+id/btnConectarIp"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:layout_marginStart="8dp"
                        android:backgroundTint="@color/red_accent"
                        android:text="Conectar por IP"
                        android:textColor="@color/snow_white" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="La IP se ve en la tele en Ajustes → Red → Acerca de"
                    android:textColor="@color/sage"
                    android:textSize="12sp"
                    android:layout_marginTop="6dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Para transmitir necesitas instalar gratis en la tele el canal «Web Video Caster - Receiver» (Streaming Channels)."
                    android:textColor="@color/sage"
                    android:textSize="12sp"
                    android:layout_marginTop="4dp" />
            </LinearLayout>

            <!-- Transmitir enlace -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Transmitir un enlace"
                android:textColor="@color/sage"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/card_bg"
                android:orientation="vertical"
                android:padding="12dp">

                <EditText
                    android:id="@+id/etCastLink"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/card_bg"
                    android:hint="Pega un enlace (YouTube, TikTok, X…)"
                    android:inputType="textUri"
                    android:textColor="@color/snow_white"
                    android:textColorHint="@color/sage" />

                <Button
                    android:id="@+id/btnCastLink"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:backgroundTint="@color/red_accent"
                    android:text="Transmitir enlace a la tele"
                    android:textColor="@color/snow_white" />

                <TextView
                    android:id="@+id/tvCastStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="@color/sage"
                    android:textSize="13sp"
                    android:layout_marginTop="8dp" />
            </LinearLayout>

            <!-- Sitios -->
            <TextView
                android:id="@+id/tvSitesTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="1,731 páginas para transmitir"
                android:textColor="@color/snow_white"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginTop="20dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Explora y accede a tus sitios favoritos"
                android:textColor="@color/sage"
                android:textSize="13sp"
                android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/etBuscarSitio"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/card_bg"
                android:hint="Buscar sitio…"
                android:inputType="text"
                android:textColor="@color/snow_white"
                android:textColorHint="@color/sage" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvSites"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:layout_marginTop="8dp" />

            <Button
                android:id="@+id/btnAcercaDe"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="16dp"
                android:backgroundTint="@color/pine_light"
                android:text="Acerca de"
                android:textColor="@color/snow_white" />
        </LinearLayout>
    </ScrollView>

    <com.elanticristo616.browser.SnowView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="false"
        android:focusable="false" />

</FrameLayout>
