<?xml version="1.0" encoding="utf-8"?>
<!-- CuteNovna Browser v1.1.0 — PANTALLA 1: LA PUERTA.
     Look fijo de la referencia (neón rosa/teal, sin temas ni
     partículas). La IP de la tele es el requisito para entrar;
     si la tele no es Roku, el botón "Buscar teles" descubre las
     teles del Wi-Fi (Chromecast y DLNA también). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_neon_base">

    <com.elanticristo616.browser.NeonGlowView
        android:id="@+id/glowView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="false"
        android:focusable="false" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tvTitulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="CuteNovna Browser"
                android:textColor="@color/neo_text"
                android:textSize="28sp"
                android:textStyle="bold"
                android:layout_marginTop="32dp" />

            <TextView
                android:id="@+id/tvSubtitulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Busca con DuckDuckGo y manda videos a tu tele"
                android:textColor="@color/neo_muted"
                android:textSize="14sp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="24dp" />

            <!-- Conectar a la tele -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/ic_tv"
                    android:tint="@color/neo_teal" />

                <TextView
                    android:id="@+id/tvConectar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="Conectar a la tele"
                    android:textColor="@color/neo_text"
                    android:textSize="20sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/cardConectar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_card_dark"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tvStatusTele"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Escribe la IP de tu tele para entrar."
                    android:textColor="@color/neo_text"
                    android:textSize="14sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_pill_dark"
                    android:gravity="center_vertical"
                    android:paddingStart="12dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="6dp"
                    android:paddingBottom="6dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_nodes"
                        android:tint="@color/neo_muted" />

                    <EditText
                        android:id="@+id/etIpManual"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:background="@android:color/transparent"
                        android:hint="192.168.1.5"
                        android:imeOptions="actionDone"
                        android:inputType="text"
                        android:maxLength="15"
                        android:textColor="@color/neo_text"
                        android:textColorHint="@color/neo_muted"
                        android:textSize="16sp" />

                    <Button
                        android:id="@+id/btnConectarIp"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_gradient_button"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:text="Conectar por IP"
                        android:textColor="@color/neo_text"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvAyudaIp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="La IP se ve en la tele en Ajustes → Red → Acerca de"
                    android:textColor="@color/neo_text"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvAyudaCanal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Para transmitir a una Roku necesitas instalar gratis en la tele el canal Web Video Caster - Receiver"
                    android:textColor="@color/neo_text"
                    android:textSize="13sp" />
            </LinearLayout>

            <Button
                android:id="@+id/btnBuscarTeles"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_card_dark"
                android:text="Mi tele no es Roku: buscar teles en el Wi-Fi"
                android:textColor="@color/neo_teal"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvBuscando"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Buscando teles en el Wi-Fi…"
                android:textColor="@color/neo_muted"
                android:textSize="13sp"
                android:visibility="gone"
                android:layout_marginTop="12dp" />
        </LinearLayout>
    </ScrollView>

</FrameLayout>
