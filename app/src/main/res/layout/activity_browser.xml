<?xml version="1.0" encoding="utf-8"?>
<!-- CuteNovna Browser v1.1.0: navegador mínimo (estilo v1.0.3) con el
     look fijo neón de la referencia. Barra superior delgada, WebView
     a pantalla completa, barra inferior delgada. La detección de video
     es solo una barrita píldora; las calidades viven en un bottom
     sheet. El reproductor nuevo: barra arrastrable, tiempo, play/pausa
     grande, ±10 s, velocidad y pantalla completa. Sin temas ni
     partículas. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_neon_base">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Barra superior delgada: volver, dirección, Ir -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="8dp">

            <Button
                android:id="@+id/btnVolver"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:backgroundTint="@color/neo_surface_light"
                android:text="‹"
                android:textColor="@color/neo_text"
                android:textSize="22sp" />

            <EditText
                android:id="@+id/etDireccion"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_card_dark"
                android:drawablePadding="8dp"
                android:drawableStart="@drawable/ic_lock"
                android:drawableTint="@color/neo_muted"
                android:hint="Busca o escribe una dirección"
                android:imeOptions="actionGo"
                android:inputType="textUri"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textColor="@color/neo_text"
                android:textColorHint="@color/neo_muted" />

            <Button
                android:id="@+id/btnIr"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_gradient_button"
                android:text="Ir"
                android:textColor="@color/neo_text"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- La página llena la pantalla -->
        <WebView
            android:id="@+id/webView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Barrita píldora: TODOS los videos detectados (oculta si no
             hay ninguno). Es un botón desplegable: al tocarla abre el
             bottom sheet con la lista de videos y sus calidades. -->
        <LinearLayout
            android:id="@+id/pillDetected"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_bottom_bar"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingTop="10dp"
            android:paddingEnd="10dp"
            android:paddingBottom="10dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_tv"
                android:tint="@color/neo_pink" />

            <TextView
                android:id="@+id/tvPillText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:text="1 video ▾"
                android:textColor="@color/neo_text"
                android:textSize="15sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnPillTransmitir"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:background="@drawable/bg_gradient_button"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:text="Transmitir"
                android:textColor="@color/neo_text"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Reproductor nuevo (oculto si no se transmite).
             Fila 1: título + estado + Parar.
             Fila 2: barra arrastrable + tiempo actual/total.
             Fila 3: −10 s, play/pausa grande, +10 s, velocidad,
             pantalla completa. -->
        <LinearLayout
            android:id="@+id/castBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_bottom_bar"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingTop="10dp"
            android:paddingEnd="10dp"
            android:paddingBottom="10dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvPlayerTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="Video"
                        android:textColor="@color/neo_text"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvCastBarStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Transmitiendo…"
                        android:textColor="@color/neo_muted"
                        android:textSize="12sp" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnCastParar"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginStart="8dp"
                    android:backgroundTint="@color/neo_surface_light"
                    android:text="Parar"
                    android:textColor="@color/neo_text"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <SeekBar
                    android:id="@+id/seekCast"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:max="0"
                    android:progress="0" />

                <TextView
                    android:id="@+id/tvCastTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="0:00 / 0:00"
                    android:textColor="@color/neo_muted"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnSeekBack"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:backgroundTint="@color/neo_surface_light"
                    android:text="−10 s"
                    android:textColor="@color/neo_text"
                    android:textSize="13sp" />

                <ImageButton
                    android:id="@+id/btnPlayerPlay"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/bg_gradient_button"
                    android:contentDescription="Pausa o seguir"
                    android:padding="14dp"
                    android:src="@drawable/ic_pause"
                    android:tint="@color/neo_text" />

                <Button
                    android:id="@+id/btnSeekFwd"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_marginStart="12dp"
                    android:backgroundTint="@color/neo_surface_light"
                    android:text="+10 s"
                    android:textColor="@color/neo_text"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btnCastVelocidad"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_marginStart="12dp"
                    android:backgroundTint="@color/neo_surface_light"
                    android:text="1×"
                    android:textColor="@color/neo_text"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <ImageButton
                    android:id="@+id/btnCastPantalla"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="8dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Pantalla completa"
                    android:src="@drawable/ic_fullscreen"
                    android:tint="@color/neo_muted" />
            </LinearLayout>
        </LinearLayout>

        <!-- Barra inferior delgada: atrás, adelante, transmitir, menú -->
        <LinearLayout
            android:id="@+id/navBar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@color/neo_surface"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnNavAtras"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Atrás"
                android:src="@drawable/ic_chevron_left"
                android:tint="@color/neo_muted" />

            <ImageButton
                android:id="@+id/btnNavAdelante"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Adelante"
                android:src="@drawable/ic_chevron_right"
                android:tint="@color/neo_muted" />

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageButton
                        android:id="@+id/btnNavTransmitir"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Transmitir"
                        android:src="@drawable/ic_cast"
                        android:tint="@color/neo_text" />

                    <TextView
                        android:id="@+id/tvNavTv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="TV"
                        android:textColor="@color/neo_muted"
                        android:textSize="10sp" />
                </LinearLayout>

                <!-- Punto verde: conectado a la tele -->
                <View
                    android:id="@+id/dotConexion"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_gravity="top|center_horizontal"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_dot_green"
                    android:visibility="gone" />
            </FrameLayout>

            <ImageButton
                android:id="@+id/btnNavMenu"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Menú"
                android:src="@drawable/ic_menu"
                android:tint="@color/neo_muted" />
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
