<?xml version="1.0" encoding="utf-8"?>
<!-- CuteNovna Browser v1.0.3: navegador mínimo estilo Brave (Opción B).
     Barra superior delgada, WebView a pantalla completa, barra inferior
     delgada. Nada tapa la página: la detección de video es solo una
     barrita píldora que aparece cuando hay videos reales, y las
     calidades viven en un bottom sheet. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Barra superior delgada: volver, dirección, Ir -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="8dp">

            <Button
                android:id="@+id/btnVolver"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:backgroundTint="@color/pine_light"
                android:text="‹"
                android:textColor="@color/snow_white"
                android:textSize="22sp" />

            <EditText
                android:id="@+id/etDireccion"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/card_bg"
                android:drawablePadding="8dp"
                android:drawableStart="@drawable/ic_lock"
                android:drawableTint="@color/sage"
                android:hint="Busca o escribe una dirección"
                android:imeOptions="actionGo"
                android:inputType="textUri"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textColor="@color/snow_white"
                android:textColorHint="@color/sage" />

            <Button
                android:id="@+id/btnIr"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:backgroundTint="@color/red_accent"
                android:text="Ir"
                android:textColor="@color/snow_white"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- La página llena la pantalla -->
        <WebView
            android:id="@+id/webView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Barrita píldora: TODOS los videos detectados (oculta si no
             hay ninguno). Es un botón desplegable: al tocarla abre el
             bottom sheet con la lista de videos y sus calidades. -->
        <LinearLayout
            android:id="@+id/pillDetected"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_bottom_bar"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingTop="10dp"
            android:paddingEnd="10dp"
            android:paddingBottom="10dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_tv"
                android:tint="@color/red_accent" />

            <TextView
                android:id="@+id/tvPillText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:text="1 video ▾"
                android:textColor="@color/snow_white"
                android:textSize="15sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnPillTransmitir"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:background="@drawable/bg_red_pill"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:text="Transmitir"
                android:textColor="@color/snow_white"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Barrita de control mientras se transmite (oculta si no).
             Fila 1: estado + Pausa / Seguir / Parar.
             Fila 2 (v1.0.4): saltos -10 s / +10 s y barra de progreso
             con el tiempo (la posición la reporta el canal). -->
        <LinearLayout
            android:id="@+id/castBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_bottom_bar"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingTop="8dp"
            android:paddingEnd="8dp"
            android:paddingBottom="8dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvCastBarStatus"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Transmitiendo…"
                    android:textColor="@color/sage"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btnCastPausa"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:backgroundTint="@color/pine_light"
                    android:text="Pausa"
                    android:textColor="@color/snow_white"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btnCastSeguir"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginStart="6dp"
                    android:backgroundTint="@color/pine_light"
                    android:text="Seguir"
                    android:textColor="@color/snow_white"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btnCastParar"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginStart="6dp"
                    android:backgroundTint="@color/pine_light"
                    android:text="Parar"
                    android:textColor="@color/snow_white"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnSeekBack"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:backgroundTint="@color/pine_light"
                    android:text="−10 s"
                    android:textColor="@color/snow_white"
                    android:textSize="12sp" />

                <SeekBar
                    android:id="@+id/seekCast"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:max="0"
                    android:progress="0" />

                <TextView
                    android:id="@+id/tvCastTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0:00 / 0:00"
                    android:textColor="@color/sage"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btnSeekFwd"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginStart="8dp"
                    android:backgroundTint="@color/pine_light"
                    android:text="+10 s"
                    android:textColor="@color/snow_white"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Barra inferior delgada: atrás, adelante, transmitir, menú -->
        <LinearLayout
            android:id="@+id/navBar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@color/pine_dark"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnNavAtras"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Atrás"
                android:src="@drawable/ic_chevron_left"
                android:tint="@color/sage" />

            <ImageButton
                android:id="@+id/btnNavAdelante"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Adelante"
                android:src="@drawable/ic_chevron_right"
                android:tint="@color/sage" />

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageButton
                        android:id="@+id/btnNavTransmitir"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Transmitir"
                        android:src="@drawable/ic_cast"
                        android:tint="@color/snow_white" />

                    <TextView
                        android:id="@+id/tvNavTv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="TV"
                        android:textColor="@color/sage"
                        android:textSize="10sp" />
                </LinearLayout>

                <!-- Punto verde: conectado a la tele -->
                <View
                    android:id="@+id/dotConexion"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_gravity="top|center_horizontal"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_dot_green"
                    android:visibility="gone" />
            </FrameLayout>

            <ImageButton
                android:id="@+id/btnNavMenu"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Menú"
                android:src="@drawable/ic_menu"
                android:tint="@color/sage" />
        </LinearLayout>
    </LinearLayout>

    <com.elanticristo616.browser.ParticleView
        android:id="@+id/particleView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="false"
        android:focusable="false" />

</FrameLayout>
