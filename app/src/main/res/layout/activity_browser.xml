<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Reproductor de Video -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="8dp">

            <Button
                android:id="@+id/btnVolver"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:backgroundTint="@color/pine_light"
                android:text="‹"
                android:textColor="@color/snow_white"
                android:textSize="22sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="Reproductor de Video"
                android:textColor="@color/snow_white"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingBottom="8dp">

            <EditText
                android:id="@+id/etDireccion"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@drawable/card_bg"
                android:hint="Busca o escribe una dirección"
                android:imeOptions="actionGo"
                android:inputType="textUri"
                android:textColor="@color/snow_white"
                android:textColorHint="@color/sage" />

            <Button
                android:id="@+id/btnIr"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:backgroundTint="@color/red_accent"
                android:text="Ir"
                android:textColor="@color/snow_white" />
        </LinearLayout>

        <WebView
            android:id="@+id/webView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <LinearLayout
                    android:id="@+id/detectedCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/card_bg"
                    android:orientation="vertical"
                    android:padding="12dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Video detectado en esta página"
                        android:textColor="@color/snow_white"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvDetectedUrl"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="middle"
                        android:maxLines="2"
                        android:textColor="@color/sage"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="CALIDAD DE VIDEO"
                        android:textColor="@color/sage"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:layout_marginTop="10dp" />

                    <LinearLayout
                        android:id="@+id/qualityChips"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />

                    <TextView
                        android:id="@+id/tvQualityInfo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textColor="@color/sage"
                        android:textSize="12sp" />

                    <Button
                        android:id="@+id/btnTransmitirDetectado"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_red_pill"
                        android:drawableStart="@drawable/ic_tv"
                        android:drawablePadding="10dp"
                        android:text="Transmitir este video a la tele"
                        android:textColor="@color/snow_white"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Conectado a Roku TV -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/card_bg"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_tv" />

                        <TextView
                            android:id="@+id/tvConexionRoku"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="Conectado a Roku TV"
                            android:textColor="@color/sage"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvCastStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Abre una página con video y te aviso para transmitirlo."
                        android:textColor="@color/sage"
                        android:textSize="13sp" />
                </LinearLayout>

                <!-- Pega un enlace (yt-dlp) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/card_bg"
                    android:orientation="vertical"
                    android:padding="12dp"
                    android:layout_marginTop="8dp">

                    <EditText
                        android:id="@+id/etEnlace"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@drawable/card_bg"
                        android:hint="Pega un enlace (YouTube, TikTok, X…)"
                        android:inputType="textUri"
                        android:textColor="@color/snow_white"
                        android:textColorHint="@color/sage" />

                    <Button
                        android:id="@+id/btnTransmitirEnlace"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:backgroundTint="@color/red_accent"
                        android:text="Transmitir enlace a la tele"
                        android:textColor="@color/snow_white" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="8dp">

                    <Button
                        android:id="@+id/btnCastPausa"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:backgroundTint="@color/pine_light"
                        android:text="Pausa"
                        android:textColor="@color/snow_white" />

                    <Button
                        android:id="@+id/btnCastSeguir"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:backgroundTint="@color/pine_light"
                        android:text="Seguir"
                        android:textColor="@color/snow_white" />

                    <Button
                        android:id="@+id/btnCastParar"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:backgroundTint="@color/pine_light"
                        android:text="Parar"
                        android:textColor="@color/snow_white" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <com.elanticristo616.browser.SnowView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="false"
        android:focusable="false" />

</FrameLayout>
