<?xml version="1.0" encoding="utf-8"?>
<!-- Reproductor a pantalla completa v1.1.0: los mismos controles
     de la barrita, en grande. Se abre desde el botón de pantalla
     completa mientras se transmite. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_neon_base"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/dlgPlayerTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="Video"
        android:textColor="@color/neo_text"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/dlgPlayerStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="Transmitiendo…"
        android:textColor="@color/neo_muted"
        android:textSize="14sp"
        android:layout_marginTop="6dp" />

    <SeekBar
        android:id="@+id/dlgSeek"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="48dp"
        android:max="0"
        android:progress="0" />

    <TextView
        android:id="@+id/dlgTime"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="0:00 / 0:00"
        android:textColor="@color/neo_muted"
        android:textSize="15sp"
        android:layout_marginTop="8dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:gravity="center"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnDlgBack"
            android:layout_width="wrap_content"
            android:layout_height="56dp"
            android:backgroundTint="@color/neo_surface_light"
            android:text="−10 s"
            android:textColor="@color/neo_text"
            android:textSize="15sp" />

        <ImageButton
            android:id="@+id/btnDlgPlay"
            android:layout_width="84dp"
            android:layout_height="84dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:background="@drawable/bg_gradient_button"
            android:contentDescription="Pausa o seguir"
            android:padding="20dp"
            android:src="@drawable/ic_pause"
            android:tint="@color/neo_text" />

        <Button
            android:id="@+id/btnDlgFwd"
            android:layout_width="wrap_content"
            android:layout_height="56dp"
            android:backgroundTint="@color/neo_surface_light"
            android:text="+10 s"
            android:textColor="@color/neo_text"
            android:textSize="15sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="center"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnDlgSpeed"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:backgroundTint="@color/neo_surface_light"
            android:text="Velocidad 1×"
            android:textColor="@color/neo_text"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnDlgStop"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginStart="12dp"
            android:backgroundTint="@color/neo_surface_light"
            android:text="Parar"
            android:textColor="@color/neo_text"
            android:textSize="14sp" />
    </LinearLayout>

    <Button
        android:id="@+id/btnDlgCerrar"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="40dp"
        android:background="@drawable/bg_gradient_button"
        android:text="Cerrar reproductor"
        android:textColor="@color/neo_text"
        android:textSize="15sp"
        android:textStyle="bold" />
</LinearLayout>
