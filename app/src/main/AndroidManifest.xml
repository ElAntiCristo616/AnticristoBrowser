<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Red local: hablar con la Roku por ECP (HTTP plano, puerto 8060) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AnticristoBrowser"
        android:usesCleartextTraffic="true"
        android:extractNativeLibs="true">
        <!-- Google Cast (v1.1.0): el SDK exige declarar el proveedor
             de opciones, que fija el receptor por defecto. -->
        <meta-data
            android:name="com.google.android.gms.cast.framework.OPTIONS_PROVIDER_CLASS_NAME"
            android:value="com.elanticristo616.browser.CastOptionsProvider" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".PortalActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".BrowserActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
    </application>

</manifest>
